aws_region        = "<YOUR_AWS_REGION>"       # e.g. "us-west-2"
app               = "autoptic"
env               = "<ENV_NAME>"              # e.g. "prod", "staging", "test"
tenant_short_name = "<YOUR_TENANT_SHORT_NAME>" # lowercase letters/digits only, matches config.json's tenant short name

# vpc_cidr           = "10.0.0.0/16"
# single_nat_gateway = true   # true = 1 shared NAT Gateway (cheaper); false = 1 per AZ (HA)
# container_insights = false

server_image  = "autoptic/server:latest"
ui_image      = "autoptic/ui:latest"
metrics_image = "autoptic/metrics:latest"
vectors_image = "autoptic/vectors:latest"
mcp_image     = "autoptic/mcp:latest"

# server_health_path defaults to "health" (confirmed against the Kubernetes Helm chart's
# probes) -- override only if your images use a different path.
# server_health_path = "health"

deploy_artifacts_bucket_name = "<YOUR_DEPLOY_ARTIFACTS_BUCKET>" # must be globally unique
config_json_path             = "./config.json"

# mcp_admin_tools_enabled = false
# mcp_server_id           = "local-demo" # must match a key suffix in the external token registry
# mcp_server_token        = ""           # leave empty to auto-generate
