aws_region        = "<YOUR_AWS_REGION>"       # e.g. "us-west-2"
app               = "autoptic"
env               = "<ENV_NAME>"              # e.g. "prod", "staging", "test"
tenant_short_name = "<YOUR_TENANT_SHORT_NAME>" # lowercase letters/digits only, matches config.json's tenant short name

# vpc_cidr           = "10.1.0.0/16"
# single_nat_gateway = true   # true = 1 shared NAT Gateway (cheaper); false = 1 per AZ (HA)
# container_insights = false

server_image  = "autoptic/server:latest"
ui_image      = "autoptic/ui:latest"
metrics_image = "autoptic/metrics:latest"
vectors_image = "autoptic/vectors:latest"
mcp_image     = "autoptic/mcp:1.12.0" # use 1.11.0 or later

# server_health_path defaults to "health". Override it only if your images use a different path.
# server_health_path = "health"

deploy_artifacts_bucket_name = "<YOUR_DEPLOY_ARTIFACTS_BUCKET>" # must be globally unique
config_json_path             = "./config.json"

# mcp_admin_tools_enabled = false

# Access control is on by default. To opt out, set both to false. With auth_enforce = false, the
# public ALB has no /autoptic-api/ route.
# auth_enforce     = true
# auth_permissions = true
# auth_observe     = false
# ui_role_mapping  = ""  # for example "user=role.operator"

# The server task role reads CloudWatch, CloudTrail and Cost Explorer for AWS sources with
# "use_iam": true. Set false when no AWS source reads this account.
# aws_telemetry_read = true

# Idle timeout of the public and internal-server ALBs. Long agent runs and MCP streams need it.
# alb_idle_timeout = 300

# Bedrock Mantle access for GPT-6 Luna. Creates an IAM user, a long-term Bedrock API key, and a
# Secrets Manager secret. Copy the key into the Autoptic secret bedrock.token after the apply.
# bedrock_enable       = false
# bedrock_key_age_days = 90
